@unpublished{tankaria2024regularized,
  title={Regularized Nystr{\"o}m Method for Large-Scale Unconstrained Non-Convex Optimization},
  author={Tankaria, Hardik},
  year={2024},
  url={https://www.researchgate.net/profile/Hardik-Tankaria/publication/380000293_Regularized_Nystrom_method_for_Large-Scale_Unconstrained_Non-Convex_Optimization/links/6626b65443f8df018d21b6eb/Regularized-Nystroem-method-for-Large-Scale-Unconstrained-Non-Convex-Optimization.pdf},
  abbr={Preprint},
  bibtex_show={true},
  abstract={We propose a quasi-Newton type regularized Nystrom method for solving unconstrained large-scale
  non-convex optimization problems with high-dimensional feature spaces, focusing on l2-regularized objectives.
  The Hessian of a non-convex function may have negative eigenvalues; we address this by incorporating a
  regularization parameter to obtain a positive definite matrix and a descent direction, giving a regularized
  fixed-rank Nystrom approximation whose rank is selectable through random column sampling. We establish global
  convergence under standard assumptions and provide an analysis of the global complexity.}
}

@unpublished{tankaria2021nyscurve,
  title={Nys-curve{:} Nystr{\"o}m-approximated curvature for stochastic optimization},
  author={Tankaria, Hardik and Singh, Dinesh and Yamada, Makoto},
  year={2021},
  arxiv={2110.08577},
  abbr={arXiv},
  bibtex_show={true},
  abstract={We propose an approximate Newton step-based stochastic optimization algorithm for large-scale
  empirical risk minimization of convex functions with linear convergence rates. We compute a partial column
  Hessian of size (d x k) with k < d randomly selected variables, then use the Nystrom method to better
  approximate the full Hessian matrix. To further reduce computational complexity per iteration, we directly
  compute the update step without computing and storing the full Hessian or its inverse. We also use
  distribution-preserving sub-sampling to compute a partial Hessian, and integrate the approximation with
  stochastic gradient descent and stochastic variance-reduced gradients.}
}

