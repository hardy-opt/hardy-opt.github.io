@inproceedings{tankaria2026nysreg,
  title={NysReg-Gradient{:} Regularized Nystr{\"o}m-Gradient for Large-Scale Unconstrained Optimization and its Application},
  author={Tankaria, Hardik and Yamada, Makoto and Singh, Dinesh},
  booktitle={IEEE International Joint Conference on Neural Networks (IJCNN), IEEE World Congress on Computational Intelligence (WCCI)},
  address={Maastricht, Netherlands},
  year={2026},
  preview={NysNewtoncomp.gif},
  abbr={IJCNN},
  selected={true},
  bibtex_show={true},
  abstract={We develop a regularized Nystrom method for solving unconstrained optimization problems with
  high-dimensional feature spaces. The method leverages actual Hessian information through a regularized Nystrom
  approximation, integrating the approximated Hessian with gradient descent and stochastic gradient descent. We
  establish global convergence and analyse the global complexity. Numerical experiments show that it notably
  outperforms randomized subspace Newton and the approximation of Newton-sketch, showing considerable advancement
  in optimization with high-dimensional feature spaces.}
}

