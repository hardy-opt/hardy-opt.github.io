@phdthesis{tankaria2024thesis,
  title={The Utilization of Second-Order Information for Large-Scale Unconstrained Optimization Problems},
  author={Tankaria, Hardik},
  school={Kyoto University, Graduate School of Informatics},
  address={Kyoto, Japan},
  year={2024},
  month={3},
  url={https://www-optima.amp.i.kyoto-u.ac.jp/papers/doctor/2024_doctor_hardik.pdf},
  pdf={https://www-optima.amp.i.kyoto-u.ac.jp/papers/doctor/2024_doctor_hardik.pdf},
  preview={Nystromproc.gif},
  abbr={PhD Thesis},
  bibtex_show={true},
  abstract={Doctoral thesis. Second-order and variance-reduced methods for large-scale unconstrained
  optimization: a regularized L-BFGS method with global convergence and fewer function evaluations;
  a stochastic variance reduced gradient using Barzilai-Borwein curvature as second-order information;
  and the regularized Nystrom approximation of the Hessian, which reduces per-iteration cost from
  O(nd^2 + d^3) to O(ndm + dm^2) with a sketch of roughly 5 to 20 percent of the feature dimension
  while keeping the step a descent direction on non-convex objectives. Department of Applied
  Mathematics and Physics, Kyoto University.}
}

